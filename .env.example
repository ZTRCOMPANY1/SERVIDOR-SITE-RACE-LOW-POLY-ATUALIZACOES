# Modelo local. Copie para .env e preencha os valores fora do Git.
# Nunca coloque valores reais de senha/chave neste arquivo.
ADMIN_USER=replace-with-admin-username
ADMIN_PASS=replace-with-unique-strong-password
CORS_ORIGIN=https://racelowpoly.ztrcompany.site
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
PORT=3000

# Optional exception only for a reviewed self-signed DB certificate:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
